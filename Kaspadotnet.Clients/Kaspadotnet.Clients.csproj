<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kaspadontnet.Clients</RootNamespace>
    <Description>Kaspa .NET gRPC/REST client layer. Complements lifeme2027/kaswallet.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="kaspawalletd.proto" GrpcServices="Client" Access="Public" />
    <Protobuf Include="messages.proto" GrpcServices="Client" Access="Public" />
    <Protobuf Include="p2p.proto" GrpcServices="Client" Access="Public" />
    <Protobuf Include="rpc.proto" GrpcServices="Client" Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
